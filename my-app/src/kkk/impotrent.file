import { useState } from "react";
import { Link } from "react-router-dom";
import { List } from "react-bootstrap-icons"; // ☰ menu icon

export default function ChatboxUI({ username }) {
  const [messages, setMessages] = useState([
    { sender: "🤖 AI", text: "Hello! How can I help you?" },
    { sender: username || "🙂 You", text: "Hi! I just logged in." }
  ]);
  const [input, setInput] = useState("");
  const [file, setFile] = useState(null);
  const [showMenu, setShowMenu] = useState(false);

  const sendMessage = () => {
    if (!input.trim()) return;
    setMessages([...messages, { sender: username || "🙂 You", text: input }]);
    setInput("");
  };

  return (
    <div className="d-flex flex-column" style={{ height: "100vh" }}>
      {/* Header */}
      <div className="bg-primary text-white p-2 d-flex align-items-center justify-content-between">
        <div className="d-flex align-items-center">
          <button
            className="btn btn-light me-2"
            onClick={() => setShowMenu(!showMenu)}
          >
            <List size={22} />
          </button>
          <h6 className="m-0">Aichat&lt;</h6>
        </div>
        <h6 className="m-0">AI Assistant</h6>
      </div>

      {/* Dropdown Menu */}
      {showMenu && (
        <div className="bg-light border p-2">
          <ul className="list-unstyled mb-0">
            <li><Link to="/">Home</Link></li>
            <li><Link to="/login">Login</Link></li>
            <li><Link to="/register">Register</Link></li>
            <li><Link to="/about">About</Link></li>
          </ul>
        </div>
      )}

      {/* Chat Area */}
      <div className="flex-grow-1 p-3" style={{ overflowY: "auto", background: "#f5f5f5" }}>
        {messages.map((msg, i) => (
          <div
            key={i}
            className={`d-flex mb-3 ${
              msg.sender.includes("You") ? "justify-content-end" : "justify-content-start"
            }`}
          >
            <div
              className={`p-2 rounded-3 shadow-sm ${
                msg.sender.includes("You")
                  ? "bg-success text-white"
                  : "bg-white border"
              }`}
              style={{ maxWidth: "70%" }}
            >
              <strong>{msg.sender}</strong>
              <div>{msg.text}</div>
            </div>
          </div>
        ))}
      </div>

      {/* Input Area */}
      <div className="border-top p-2 bg-white">
        <div className="d-flex align-items-center">
          <input
            type="file"
            className="form-control me-2"
            style={{ maxWidth: "200px" }}
            onChange={(e) => setFile(e.target.files[0])}
          />
          {file && <small className="text-success me-2">{file.name}</small>}
          <input
            className="form-control me-2"
            value={input}
            onChange={(e) => setInput(e.target.value)}
            placeholder="Type a message..."
          />
          <button className="btn btn-primary" onClick={sendMessage}>
            Send ▶
          </button>
        </div>
      </div>
    </div>
  );
}
